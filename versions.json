{
  "_comment": "Authoritative compatibility manifest. settings.gradle, the build, CI, the release workflow and the doc generators all read this file. Nothing here may be duplicated elsewhere. See docs/ADDING_VERSION.md.",
  "modVersion": "1.2.0",
  "buildFamilies": {
    "legacy-remapped": {
      "description": "Minecraft <= 1.21.11 ships obfuscated, so Loom remaps the mod against official Mojang mappings and the production artifact comes from remapJar.",
      "loomPlugin": "fabric-loom",
      "loomVersion": "1.17.20",
      "mappings": "official-mojang",
      "modDependencyConfiguration": "modImplementation",
      "productionJarTask": "remapJar"
    },
    "modern-unobfuscated": {
      "description": "Minecraft >= 26.1 ships unobfuscated (Mojang publishes no client_mappings), so Loom's non-obfuscated pipeline applies: no mappings, plain dependencies, and no remap step at all.",
      "loomPlugin": "net.fabricmc.fabric-loom",
      "loomVersion": "1.17.20",
      "mappings": "none",
      "modDependencyConfiguration": "implementation",
      "productionJarTask": "jar"
    }
  },
  "adapterFamilies": {
    "legacy-chat": {
      "description": "LocalPlayer.chat(String) sends both chat and commands. Replaced in 1.19 by signed chat.",
      "sourceDir": "adapters/legacy-chat"
    },
    "signed-chat": {
      "description": "1.19-1.19.2 signed chat: LocalPlayer.chatSigned / commandSigned with a nullable preview component.",
      "sourceDir": "adapters/signed-chat"
    },
    "network-chat": {
      "description": "1.19.3+ splits sending: ClientPacketListener.sendChat / sendCommand. The same Mojang-mapped names still apply on unobfuscated 26.x, so this family covers both build families.",
      "sourceDir": "adapters/network-chat"
    }
  },
  "supportTiers": {
    "A": "Latest stable Minecraft. Supported first after a Minecraft update.",
    "B": "Current/recent ecosystem versions that mods are actively built for.",
    "C": "Historical modding anchors with lasting community use.",
    "D": "Best effort. Kept while it costs nothing; no guarantee for arbitrary patches."
  },
