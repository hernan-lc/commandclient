{
  "schemaVersion": 1,
  "name": "play_sound",
  "description": "Play a sound to all players",
  "parameters": {
    "sound": {
      "type": "resource_location",
      "default": "minecraft:entity.player.levelup"
    },
    "source": {
      "type": "string",
      "default": "master"
    },
    "volume": {
      "type": "number",
      "min": 0,
      "max": 16,
      "default": 1
    },
    "pitch": {
      "type": "number",
      "min": 0.1,
      "max": 2,
      "default": 1
    }
  },
  "steps": [
    {
      "type": "sound",
      "sound": "${sound}",
      "source": "${source}",
      "target": "@a",
      "volume": "${volume}",
      "pitch": "${pitch}"
    }
  ]
}
