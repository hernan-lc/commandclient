package com.commandapi.version;

import com.commandapi.minecraft.ChatResult;
import com.commandapi.minecraft.ExecutionFeedback;
import java.util.concurrent.CompletableFuture;
import net.minecraft.client.Minecraft;

/** Generated exclusively from versions.json capabilities. Called on the client thread. */
public final class NativeCommands {
    private static final com.commandapi.minecraft.TickCommandQueue queue = new com.commandapi.minecraft.TickCommandQueue();
    private static volatile com.commandapi.config.ApiConfig configuration = com.commandapi.config.ApiConfig.defaults();
    private static volatile net.minecraft.server.MinecraftServer currentServer;
    private static volatile Object currentSession;
    public static void configure(com.commandapi.config.ApiConfig config) { configuration = config; }
    public static synchronized void observeSession(Object connection, net.minecraft.server.MinecraftServer server) {
        if (currentSession != connection || currentServer != server) queue.reset();
        currentSession = connection; currentServer = server;
    }
    public static void drain(net.minecraft.server.MinecraftServer server) {
        if (currentServer == server) queue.drain(currentSession, configuration.getCommandsPerTick(), 2000000L);
    }
    public static CompletableFuture<ChatResult> submit(String text, boolean elevated, com.commandapi.minecraft.CancellationToken cancellation) {
        Minecraft client = Minecraft.getInstance();
        if (!client.isLocalServer() || client.getSingleplayerServer() == null) return null;
        CompletableFuture<ChatResult> result = new CompletableFuture<>();
        if (client.player == null) {
            result.complete(ChatResult.failure("Player unavailable", "SESSION_UNAVAILABLE"));
            return result;
        }
        Object session = client.player.connection;
        observeSession(session, client.getSingleplayerServer());
        net.minecraft.server.MinecraftServer server = client.getSingleplayerServer();
        java.util.UUID playerId = client.player.getUUID();
        return queue.submit(session, cancellation, () -> {
            if (currentSession != session || currentServer != server || !server.isRunning())
                return ChatResult.failure("Singleplayer session ended", "SESSION_CHANGED");
            net.minecraft.server.level.ServerPlayer player = server.getPlayerList().getPlayer(playerId);
            if (player == null) return ChatResult.failure("Player unavailable", "SESSION_CHANGED");
            net.minecraft.commands.CommandSourceStack source = player.createCommandSourceStack();
            if (elevated) source = source.withPermission(${permission});
            ExecutionFeedback feedback = new ExecutionFeedback();
            source = source.withCallback(${callback});
            com.mojang.brigadier.ParseResults<net.minecraft.commands.CommandSourceStack> parsed =
                    server.getCommands().getDispatcher().parse(text.substring(1), source);
            if (parsed.getReader().canRead() || !parsed.getExceptions().isEmpty())
                return ChatResult.failure("Invalid command or insufficient permission", "COMMAND_REJECTED");
            server.getCommands().${execute};
            return feedback.result();
        }, configuration.getMaxQueuedCommands());
    }
}
